<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      https://www.kde.org/standards/kcfg/1.0/kcfg.xsd">

    <group name="Settings">
      <entry name="desktopindikator01" type="String"><default>{
          "heightWidthRatio": 60,
          "sectionDateWidthWeight": 20,
          "sectionDesktopNameWidthWeight": 30,
          "sectionDesktopNumberWidthWeight": 10,
          "sectionOrder": "date,desktopName,desktopNumber",
          "dateBackgroundColors": ["#fff"],
          "dayNameFonts": ["Serif"],
          "dayNameColors": ["#071169"],
          "dayNameScales": [30],
          "dayDateFonts": ["Sans Serif"],
          "dayDateColors": ["#071169"],
          "dayDateScales": [50],
          "desktopNameBackgroundColors": ["#aaa"],
          "desktopNameFonts": ["Serif"],
          "desktopNameColors": ["#071169"],
          "desktopNameScales": [30],
          "desktopNumberBackgroundColors": ["#071169"],
          "desktopNumberFonts": ["Serif"],
          "desktopNumberColors": ["#fff"],
          "desktopNumberScales": [70]
          }</default></entry>
    </group>
</kcfg>